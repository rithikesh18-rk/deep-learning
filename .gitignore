# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Environments / Virtual Environments
.env
.env.*
.venv
env/
venv/
ENV/

# YOLOv8 / Ultralytics runtime training runs & temporary checkpoints
runs/
*.log

# Large Dataset Archives & Raw Dataset Folders
dataset.zip
*.zip
**/dataset/raw/*
!**/dataset/raw/.gitkeep

# Runtime generated uploads, results, and SQLite database files (preserve directory placeholders)
uploads/*
!uploads/.gitkeep
**/static/uploads/*
!**/static/uploads/.gitkeep
results/*
!results/.gitkeep
database/*.db
!database/.gitkeep

# Track trained model weights required for demo
!**/models/*.pth

# IDEs and Editors
.vscode/
.idea/
*.swp
*.swo
*~

# Operating System files
.DS_Store
.DS_Store?
._*
Thumbs.db
